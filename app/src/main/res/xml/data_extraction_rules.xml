<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de extracción de datos para API 31+.

   Se aplican exactamente las mismas reglas tanto en <cloud-backup> como en
   <device-transfer>:
     - Se incluye la base de datos Room (domain "database") y las
       SharedPreferences (domain "sharedpref": alias/seudónimo y ruta de foto).
       El usuario exige que la base de datos SÍ se respalde.
     - Se excluye la foto de perfil (files/perfil.png).

   La plataforma siempre excluye la caché de forma automática, por eso no se
   declara. Al usar <include>, la lista de respaldo queda limitada a Room +
   SharedPreferences (allowlist).

   Ver https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Base de datos Room: SIEMPRE se respalda. No excluir. -->
        <include domain="database" path="." />

        <!-- Preferencias: solo alias (seudónimo) y ruta de la foto. -->
        <include domain="sharedpref" path="." />

        <!-- Foto de perfil: NO se respalda. -->
        <exclude domain="file" path="perfil.png" />
    </cloud-backup>

    <device-transfer>
        <!-- Mismas reglas que en cloud-backup. -->
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="perfil.png" />
    </device-transfer>
</data-extraction-rules>
